# Copy to .env.local and fill in values. Never commit .env.local.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
TAVILY_API_KEY=
HUNTER_API_KEY=
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
FLEXPRICE_API_KEY=
# e.g. https://us.api.flexprice.io/v1
FLEXPRICE_BASE_URL=
# Optional: Flexprice customer external id used for metering (default: signal-gtm-demo)
FLEXPRICE_CUSTOMER_ID=
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# Band (app.band.ai): one remote agent per role. Agents > Connect remote agent > copy ID + API key.
BAND_PLANNER_AGENT_ID=
BAND_PLANNER_API_KEY=
BAND_BUILDER_AGENT_ID=
BAND_BUILDER_API_KEY=
BAND_REVIEWER_AGENT_ID=
BAND_REVIEWER_API_KEY=
BAND_SECURITY_AGENT_ID=
BAND_SECURITY_API_KEY=
# Optional: the room (chat) id. If empty, the Planner uses the first room it is in.
BAND_ROOM_ID=
